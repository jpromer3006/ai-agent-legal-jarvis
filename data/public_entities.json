  "non_mta_guards": [
    "amtrak", "nj transit", "new jersey transit", "path train", "path ",
    "gas station", "police station", "fire station", "personal trainer",
    "train station of", "freight train", "cargo train"
  ],
  "entities": [
    {
      "name": "Long Island Rail Road",
