      "needs_verification": true,
      "reviewed_by": null
    },
    {
      "name": "State of New York",
      "patterns": ["\\bstate highway\\b", "\\bstate park\\b.*\\bnew york\\b", "\\bnys thruway\\b"],
      "needs_verification": true,
