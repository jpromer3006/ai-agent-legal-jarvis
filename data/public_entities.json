      "needs_verification": true,
      "reviewed_by": null
    },
    {
      "name": "Metro-North Commuter Railroad",
      "patterns": ["\\bmetro[- ]?north\\b", "\\bmnr\\b"],
      "needs_verification": true,
      "reviewed_by": null
    },
    {
      "name": "Staten Island Rapid Transit Operating Authority",
      "patterns": ["\\bstaten island railway\\b", "\\bsirtoa\\b", "\\bsir train\\b"],
      "needs_verification": true,
      "reviewed_by": null
    },
    {
      "name": "MTA Bus Company",
      "patterns": ["\\bmta bus\\b", "\\bexpress bus\\b"],
      "needs_verification": true,
      "reviewed_by": null
    },
    {
      "name": "New York City Transit Authority",
      "patterns": [
        "\\bsubway\\b", "\\bnyct\\b", "\\bmta subway\\b",
        "\\bcity bus\\b", "\\bnyct bus\\b",
        "\\bthe [a-z] train\\b", "\\b[1-7] train\\b",
