      ],
      "needs_verification": true,
      "reviewed_by": null
    },
    {
      "name": "City of New York",
      "patterns": ["\\bnyc\\b.*\\b(?:pothole|sidewalk|park|playground|school)\\b", "\\bcity of new york\\b"],
